# RabbitMQ connection string from CloudAMQP (Details page of your instance)
RABBITMQ_URL=amqps://user:password@host/vhost

# Upstash Redis connection string
REDIS_URL=rediss://default:password@host:port

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Port the worker's WebSocket server listens on
WEBSOCKET_PORT=8080

# How many jobs this worker process scores concurrently
WORKER_CONCURRENCY=4
