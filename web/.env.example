# Auth.js - generate with: npx auth secret
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth app (Google Cloud Console > Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string
DATABASE_URL=

# Optional: a GitHub personal access token raises the API rate limit for
# fetching job postings from 60/hr to 5,000/hr. Not required for local dev.
GITHUB_TOKEN=

# Optional: this email bypasses the daily search rate limit entirely - for
# the site owner testing/demoing, not a real user. Leave empty to disable.
OWNER_EMAIL=

# Public URL of the worker's WebSocket server (see worker/.env.example)
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8080
